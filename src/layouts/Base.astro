---
import { sitePath } from "../lib/paths";
import "@fontsource-variable/recursive/full.css";
import latinFont from "@fontsource-variable/recursive/files/recursive-latin-full-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  game?: string;
}

const { title, description, game } = Astro.props;
const home = sitePath();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body data-game={game}>
    {game && <header class="site-header">
      <a href={home} class="site-home"> draggle </a>
    </header>}
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        A new puzzle in each game every day. Made by <a href="https://benswift.me">Ben Swift</a>
        with <a href="https://declarative-dragging.github.io/">Dragology</a>. Ladder picks its words
        using <a href="https://github.com/rspeer/wordfreq">wordfreq</a> data (CC BY-SA 4.0).
        <a href="https://github.com/ANUcybernetics/draggle">Source</a> under the MIT licence.
      </p>
    </footer>
  </body>
</html>
